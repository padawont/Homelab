# secret.yaml.example — PLACEHOLDER ONLY. Never commit real secret values.
# Copy to secret.yaml (which must stay untracked) and replace CHANGE_ME with the
# Gmail app password for the cvsenderworkonly@gmail.com account before applying:
#   cp secret.yaml.example secret.yaml && $EDITOR secret.yaml
#   kubectl apply -f secret.yaml
# The Deployment consumes this Secret key as env GMAIL_APP_PASSWORD.
apiVersion: v1
kind: Secret
metadata:
  name: cv-sender-secrets
  namespace: cv-sender
  labels:
    app.kubernetes.io/name: cv-sender
    app.kubernetes.io/component: secret
type: Opaque
stringData:
  GMAIL_APP_PASSWORD: "CHANGE_ME"
