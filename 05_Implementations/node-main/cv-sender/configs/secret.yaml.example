# secret.yaml.example — PLACEHOLDER ONLY. Never commit real secret values.
# This Secret holds the Gmail app password AND the applicant's signature name/phone,
# which are deliberately kept out of tracked config.
# Copy to secret.yaml (which must stay untracked) and replace every CHANGE_ME with
# the real value (Gmail app password for the cvsenderworkonly@gmail.com account,
# applicant signature name and phone) before applying:
#   cp secret.yaml.example secret.yaml && $EDITOR secret.yaml
#   kubectl apply -f secret.yaml
# The Deployment consumes these Secret keys as env GMAIL_APP_PASSWORD,
# CV_SENDER_SIGNATURE_NAME and CV_SENDER_SIGNATURE_PHONE.
apiVersion: v1
kind: Secret
metadata:
  name: cv-sender-secrets
  namespace: cv-sender
  labels:
    app.kubernetes.io/name: cv-sender
    app.kubernetes.io/component: secret
type: Opaque
stringData:
  GMAIL_APP_PASSWORD: "CHANGE_ME"
  CV_SENDER_SIGNATURE_NAME: "CHANGE_ME"
  CV_SENDER_SIGNATURE_PHONE: "CHANGE_ME"
